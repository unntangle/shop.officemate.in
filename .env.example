# ---------------------------------------------------------------------------
# Template. COMMITTED ON PURPOSE — key names only, never values.
#
# Copy to `.env.local` and fill it in there:
#     cp .env.example .env.local        (macOS / Linux)
#     copy .env.example .env.local      (Windows cmd)
#
# This file exists so a new machine, or the next developer, can see which keys
# the app needs without anyone having to ask — and so a missing variable shows
# up as an obvious blank rather than a confusing runtime error.
#
# If you add a variable to .env.local, add its NAME here too. An undocumented
# key is one that gets forgotten on the next deploy.
# ---------------------------------------------------------------------------

# Shopify Storefront API — PUBLIC token only. See .env.local for which token
# to take from the Shopify admin, and why the Admin API token must never go
# behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-01

# Shopify Customer Account API — sign-in. CONFIDENTIAL client (Headless
# channel), so neither value is NEXT_PUBLIC_. See .env.local for where to find
# them and for the HTTPS-callback requirement that also applies on localhost.
SHOPIFY_CUSTOMER_CLIENT_ID=
SHOPIFY_CUSTOMER_CLIENT_SECRET=
